<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>Pham Hoang Minh Khoi</Authors>
    <Description>A local-first daily checklist for Windows with GitHub issue/PR status.</Description>
    <RepositoryUrl>https://github.com/phamhminhkhoi/TodayChecklist</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.14" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <!-- T("tiếng Việt", "English") dùng được ở mọi file -->
    <Using Include="TodayChecklist.Lang" Static="true" />
  </ItemGroup>

</Project>